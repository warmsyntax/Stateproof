{
  "name": "@stateproof-dev/cli",
  "version": "0.2.1",
  "description": "Stateproof command line: init, run, list, export",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warmsyntax/Stateproof.git",
    "directory": "packages/cli"
  },
