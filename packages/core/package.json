{
  "name": "@stateproof-dev/core",
  "version": "0.2.1",
  "description": "Pure scenario schema, request matching, result model, and card rendering for Stateproof",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warmsyntax/Stateproof.git",
    "directory": "packages/core"
  },
  "homepage": "https://stateproof.dev",
  "bugs": {
    "url": "https://github.com/warmsyntax/Stateproof/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -b",
    "gen:schema": "node scripts/generate-schema.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
