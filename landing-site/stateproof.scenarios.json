{
  "name": "landing-site",
  "baseUrl": "http://127.0.0.1:4173",
  "route": "/",
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1024, "deviceScaleFactor": 1, "isMobile": false },
    { "name": "tablet", "width": 768, "height": 1024, "deviceScaleFactor": 1, "isMobile": false },
    { "name": "mobile", "width": 390, "height": 844, "deviceScaleFactor": 2, "isMobile": true }
  ],
  "scenarios": [
    {
      "id": "landing-hero",
      "label": "Landing page hero and core navigation render",
      "request": { "method": "GET", "urlPattern": "**/never-called" },
      "response": { "mode": "offline" },
      "expect": {
        "visible": ["#top-nav", "#hero", "#mechanism"],
        "timeoutMs": 8000
      }
    },
    {
      "id": "landing-demo-explorer",
      "label": "Interactive state explorer demo station is present",
      "request": { "method": "GET", "urlPattern": "**/never-called" },
      "response": { "mode": "offline" },
      "expect": {
        "visible": ["#demo", "#integrity", "#main-content"],
        "timeoutMs": 8000
      }
    }
  ]
}
